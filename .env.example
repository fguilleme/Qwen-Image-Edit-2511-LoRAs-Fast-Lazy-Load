# Required when QWEN_SERVER_NAME is reachable from the LAN.
QWEN_AUTH_USER=change-me
QWEN_AUTH_PASSWORD=replace-with-a-long-random-password

QWEN_SERVER_NAME=0.0.0.0
QWEN_SERVER_PORT=7861
QWEN_ATTENTION_BACKEND=sdpa
QWEN_CPU_OFFLOAD=1
# Optional: defaults to .offload-cache inside the repository.
# QWEN_OFFLOAD_DIR=/path/to/qwen-image-edit-offload
